package com.br.app.controller;

import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.br.app.entity.Cart;
import com.br.app.service.CartService;

@RestController
public class CartController {
	private final CartService cartService;
	public CartController(CartService cartService) {
		this.cartService = cartService;
	}
	
	@GetMapping("/cart")	//상품 목록
	public String showCart(Model model) {
		model.addAttribute("cartList", cartService.findAll());
        model.addAttribute("cart", new Cart());
		return "cart";
	}
	
	@PostMapping("/cart/add")
    public String addItem(@ModelAttribute("cart") Cart cart) {
        cartService.add(cart);
        return "redirect:/cart";
    }

    @PostMapping("/cart/update/{no}")
    public String updateItem(@PathVariable Long no, @RequestParam int amount) {
        cartService.update(no, amount);
        return "redirect:/cart";
    }

    @PostMapping("/cart/delete/{no}")
    public String deleteItem(@PathVariable Long no) {
        cartService.delete(no);
        return "redirect:/cart";
    }
}
