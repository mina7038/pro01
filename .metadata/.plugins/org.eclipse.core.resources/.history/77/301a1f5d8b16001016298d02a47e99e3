package com.br.app.controller;

import java.util.List;

import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;

import com.br.app.entity.Cart;
import com.br.app.service.CartService;

@RestController
@RequestMapping("/cart")
public class CartController {
	private final CartService cartService;
	public CartController(CartService cartService) {
		this.cartService = cartService;
	}
	
	@GetMapping("/list")	//상품 목록
	public List<Cart> getCart() {
		return cartService.getCart();
	}
	
	@PostMapping
	public Cart add(@RequestBody Cart cart) {
		return cartService.add(cart);
	}
	
	@PutMapping("/{no}")
	public Cart update(@PathVariable Long no, @RequestBody Cart cart) {
		return cartService.update(no, cart);
	}
	
	@DeleteMapping("/{id}")
		public void delete(@PathVariable Long no) {
			cartService.delete(no);
		}
}
