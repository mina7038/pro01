@charset "utf-8";

body, button, dl, dt, dd, figure, h1, h2, h3, h4, h5, h6, ol, ul, li, p, table, td, th, legend {
    margin: 0;
    padding: 0;
}

ul li {
	list-style: none;
}

:root {
    --pink-color-1: #ffb3c3;
    --pink-color-2: #ff4d72;
    --pink-color-3: #ff7c98;
    --point-color: var(--pink-color-2);
    --brown-color-1: #41332c;
    --brown-color-2: #2f231c;
    --brown-color-3: #948780;
    --gray-color-1: #d4d4d4;
    --font-family-ko: Sandoll GothicNeo1 TTF, -apple-system, system-ui, BlinkMacSystemFont, sans-serif;
    --font-family-en: Sandoll GothicNeo1 TTF, -apple-system, system-ui, BlinkMacSystemFont, sans-serif;
    --font-family-scoop: "Scoop", Sandoll GothicNeo1 TTF, -apple-system, system-ui, BlinkMacSystemFont, sans-serif;
    --size-pc: 1500px;
    --font-weight-sd-regular: 400;
    --font-weight-sd-medium: 500;
    --font-weight-sd-semibold: 600;
    --font-weight-sd-bold: 600;
    --font-weight-sd-extrabold: 600;
    --font-weight-sd-heavy: 700;
}

    *,
    *:before,
    *:after {
      box-sizing: border-box;
    }

    html {
      line-height: 1.15;
      -webkit-text-size-adjust: 100%;
    }
    body {
        word-break: keep-all;
    }
    .site-header {
    background: transparent;
    display: flex;
    align-items: center;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 30;
    width: 100%;
    min-width: var(--size-pc);
    height: 90px;
    }

    .site-header:before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #f986bd;
    opacity: 0;
    transition: opacity .3s ease;
    content: "";
    }

    .site-header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: var(--size-pc);
    margin: 0 auto;
    }

    .site-header__content {
    display: flex;
    }

    .site-header-logo {
    position: relative;
    z-index: 20;
    }

    .site-header-logo__link {
    background-image: url(/images/h_logo.png);
    display: block;
    width: 52px;
    height: 60px;
    /* background-image: url(/assets/images/common/h_logo_white.png); */
    background-repeat: no-repeat;
    }

    .site-header-logo__img {
    overflow: hidden;
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    white-space: nowrap;
    clip: rect(0, 0, 0, 0);
    -webkit-clip-path: inset(0 0 99.9% 99.9%);
    clip-path: inset(0 0 99.9% 99.9%);
    }



    .main-hero {
      padding-top:30px;
      overflow: hidden;
      position: relative;
      background: url(/images/main_bg.jpg) repeat;
    }

    .main-hero__container {
      display: flex;
      justify-content: center;
    }

    .main-hero__content {
      position: relative;
      width: 1500px;
      height: 880px;
      padding-top: 95px;
      box-sizing: border-box;
    }
    
    .main-hero__content:before {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1500px;
    height: 840px;
    margin-left: -750px;
    background: url(/images/main_bg_frame.png) no-repeat left top / contain;
    content: "";
    z-index: 3000;
    }

    img {
    max-width: 100%;
    vertical-align: middle;
    overflow: clip;
    }

    .main-hero__link {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    width: 100%;
    height: 100%;
    }

    .main-hero__box {
    overflow: hidden;
    width: 1455px;
    height: 729px;
    margin: 0 auto;
    border-radius: 174px;
    }

    .main-hero__text {
    overflow: hidden;
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    white-space: nowrap;
    clip: rect(0, 0, 0, 0);
    -webkit-clip-path: inset(0 0 99.9% 99.9%);
    clip-path: inset(0 0 99.9% 99.9%);
  }
  
