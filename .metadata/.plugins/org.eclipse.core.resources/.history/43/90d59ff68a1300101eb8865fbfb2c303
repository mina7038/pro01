<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<link rel="stylesheet" th:href="@{/css/style.css}" />
	<title>baskinrobbins</title>
</head>

<body>
	<div class="container">
		<header class="header">
			<nav class="navbar navbar-expand-lg bg-body-tertiary">
				<div class="container-fluid">
					<a class="navbar-brand" href="/"><img src="./images/h_logo.png" alt=".."></a>
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
						aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="navbarNav">
						<ul class="navbar-nav">
							<li class="nav-item">
								<a class="nav-link active" aria-current="page" href="/">Home</a>
							</li>
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
									aria-expanded="false">
									게시판
								</a>
								<ul class="dropdown-menu">
									<li><a class="dropdown-item" href="/board/list">게시판 목록</a></li>
									<li><a class="dropdown-item" href="/board/ins">게시판 글 추가</a></li>
									<li>
										<hr class="dropdown-divider">
									</li>
									<li><a class="dropdown-item" href="#">메뉴</a></li>
								</ul>
							</li>
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
									aria-expanded="false">
									회원
								</a>
								<ul class="dropdown-menu">
									<li th:if="${session.loginMember != null and login.Member}"><a class="dropdown-item"
											href="/member/list">회원목록</a></li>
									<li th:if="${session.loginMember != null}"><a class="dropdown-item"
											href="/member/add">회원등록</a></li>
									<li th:if="${session.loginMember != null}">
										<hr class="dropdown-divider">
									</li>
									<li th:if="${session.loginMember == null}"><a class="dropdown-item"
											href="/member/join">회원가입</a></li>
									<li th:if="${session.loginMember == null}"><a class="dropdown-item"
											href="/member/login">로그인</a></lith:if="${session.loginMember==null}">
									<li th:if="${session.loginMember != null}"><a class="dropdown-item"
											href="/member/mypage">마이페이지</a></li>
									<li th:if="${session.loginMember != null}"><a class="dropdown-item"
											href="/member/logout">로그아웃</a></li>
								</ul>
							</li>

						</ul>
					</div>
					<ul class="nav justify-content-end">
						<li class="nav-item" th:if="${session.loginMember == null}">
							<a class="nav-link" href="/member/login">로그인</a>
						</li>
						<li class="nav-item" th:if="${session.loginMember == null}">
							<a class="nav-link" href="/member/join">회원가입</a>
						</li>
						<li class="nav-item" th:if="${session.loginMember != null}">
							<a class="nav-link" href="/member/logout">로그아웃</a>
						</li>
						<li class="nav-item" th:if="${session.loginMember != null}">
							<a class="nav-link" href="/member/mypage">마이페이지</a>
						</li>
					</ul>
				</div>
	</div>
	</nav>
	</header>
	<div class="container">
		<div id="carouselExample" class="carousel slide carousel-fade " data-bs-ride="carousel">
			<div class="carousel-inner">
				<div class="carousel-item active">
					<img src="./images/peko.png" class="d-block w-100" alt="...">
				</div>
				<div class="carousel-item">
					<img src="./images/greent.png" class="d-block w-100" alt="...">
				</div>
			</div>
			<button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
				<span class="carousel-control-prev-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Previous</span>
			</button>
			<button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
				<span class="carousel-control-next-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Next</span>
			</button>
		</div>
		<hr>
	</div>
	
	<div class="container">
		<p>내용</p>
		<p>나이: <strong th:text="${age}"></strong></p>
		<p>이름: <strong th:text="${name}"></strong></p>
	</div>
	</div>
</body>

</html>