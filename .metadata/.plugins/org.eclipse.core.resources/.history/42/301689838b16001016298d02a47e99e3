<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<th:block th:replace="fragments/header :: link"></th:block>
	<th:block th:replace="fragments/header :: script"></th:block>
	<title>장바구니</title>
</head>

<body>
	<th:block th:replace="fragments/header :: header"></th:block>
	<div class="container">
		
	<hr>
	<div class="first-content">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				<li class="breadcrumb-item"><a href="/">Home</a></li>
				<li class="breadcrumb-item"><a href="">회원</a></li>
				<li class="breadcrumb-item active" aria-current="page">로그인</li>
			</ol>
		</nav>
	</div>
	<div class="container">
		<h2 class="mt-4">장바구니</h2>
		<form id="addForm">
		    <label>상품명: <input type="text" id="pname" required></label>
		    <label>수량: <input type="number" id="amount" value="1" required></label>
		    <label>가격: <input type="number" id="price" value="1000" required></label>
		    <button type="submit">추가</button>
		  </form>

		  <table>
		    <thead>
		      <tr>
		        <th>ID</th>
		        <th>상품명</th>
		        <th>수량</th>
		        <th>가격</th>
		        <th>총액</th>
		        <th>수정</th>
		        <th>삭제</th>
		      </tr>
		    </thead>
		    <tbody id="cartTableBody"></tbody>
		  </table>

		  <script>
		    const API = '/cart'; // 백엔드 URL

		    async function fetchCart() {
		      const res = await fetch(API);
		      const items = await res.json();
		      const tbody = document.getElementById('cartTableBody');
		      tbody.innerHTML = '';
		      items.forEach(cart => {
		        const tr = document.createElement('tr');
		        tr.innerHTML = `
		          <td>${cart.no}</td>
		          <td>${cart.pname}</td>
		          <td><input type="number" value="${cart.amount}" onchange="updateItem(${cart.no}, this.value)"></td>
		          <td>${cart.price}</td>
		          <td>${cart.amount * item.price}</td>
		          <td><button onclick="update(${cart.id}, prompt('새 수량을 입력하세요', ${cart.amount}))">수정</button></td>
		          <td><button onclick="delete(${cart.id})">삭제</button></td>
		        `;
		        tbody.appendChild(tr);
		      });
		    }

		    async function addItem(e) {
		      e.preventDefault();
		      const pname = document.getElementById('pname').value;
		      const amount = document.getElementById('amount').value;
		      const price = document.getElementById('price').value;
		      await fetch(API, {
		        method: 'POST',
		        headers: { 'Content-Type': 'application/json' },
		        body: JSON.stringify({ pname, amount, price })
		      });
		      e.target.reset();
		      fetchCart();
		    }

		    async function delete(id) {
		      await fetch(`${API}/${no}`, { method: 'DELETE' });
		      fetchCart();
		    }

		    async function update(id, quantity) {
		      if (!quantity) return;
		      const res = await fetch(`${API}/${id}`);
		      const item = await res.json();
		      item.amount = parseInt(amount);
		      await fetch(`${API}/${id}`, {
		        method: 'PUT',
		        headers: { 'Content-Type': 'application/json' },
		        body: JSON.stringify(item)
		      });
		      fetchCart();
		    }

		    document.getElementById('addForm').addEventListener('submit', cart);
		    fetchCart();
		  </script>
</body>

</html>