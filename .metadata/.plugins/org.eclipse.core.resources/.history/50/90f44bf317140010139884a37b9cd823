<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<th:block th:replace="fragments/header :: link"></th:block>
	<th:block th:replace="fragments/header :: script"></th:block>
	<title>회원가입</title>
</head>

<body>
	<div class="container">
		<header class="header">
			<nav class="navbar navbar-expand-lg bg-body-tertiary">
				<div class="container-fluid">
					<a class="navbar-brand" href="/">Br</a>
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
						aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="navbarNav">
						<ul class="navbar-nav">
							<li class="nav-item">
								<a class="nav-link active" aria-current="page" href="/">Home</a>
							</li>
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
									aria-expanded="false">
									게시판
								</a>
								<ul class="dropdown-menu">
									<li><a class="dropdown-item" href="/board/list">게시판 목록</a></li>
									<li><a class="dropdown-item" href="/board/ins">게시판 글 추가</a></li>
									<li>
										<hr class="dropdown-divider">
									</li>
									<li><a class="dropdown-item" href="#">메뉴</a></li>
								</ul>
							</li>
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
									aria-expanded="false">
									회원
								</a>
								<ul class="dropdown-menu">
									<li th:if="${session.loginMember != null}"><a class="dropdown-item"
											href="/member/list">회원목록</a></li>
									<li th:if="${session.loginMember != null}"><a class="dropdown-item"
											href="/member/add">회원등록</a></li>
									<li th:if="${session.loginMember != null}">
										<hr class="dropdown-divider">
									</li>
									<li th:if="${session.loginMember == null}"><a class="dropdown-item"
											href="/member/join">회원가입</a></li>
									<li th:if="${session.loginMember == null}"><a class="dropdown-item"
											href="/member/login">로그인</a></li>
									<li th:if="${session.loginMember != null}"><a class="dropdown-item"
											href="/member/mypage">마이페이지</a></li>
									<li th:if="${session.loginMember != null}"><a class="dropdown-item"
											href="/member/logout">로그아웃</a></li>
								</ul>
							</li>
						</ul>
					</div>
					<ul class="nav justify-content-end">
						<li class="nav-item" th:if="${session.loginMember == null}">
							<a class="nav-link" href="/member/login">로그인</a>
						</li>
						<li class="nav-item" th:if="${session.loginMember == null}">
							<a class="nav-link" href="/member/join">회원가입</a>
						</li>
						<li class="nav-item" th:if="${session.loginMember != null}">
							<a class="nav-link" href="/member/logout">로그아웃</a>
						</li>
						<li class="nav-item" th:if="${session.loginMember != null}">
							<a class="nav-link" href="/member/mypage">마이페이지</a>
						</li>
					</ul>
				</div>
	</div>
	</nav>
	</header>
	<hr>
	<div>
		배너
	</div>
	<div class="first-content">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				<li class="breadcrumb-item"><a href="/">Home</a></li>
				<li class="breadcrumb-item"><a href="">회원</a></li>
				<li class="breadcrumb-item active" aria-current="page">회원 가입</li>
			</ol>
		</nav>
	</div>
	<tr class="container">
		<h2 class="mt-4">회원가입</h2>
		<hr>
		<table class="table">
			<tbody>
				<tr>
					<th>아이디</th>
					<td th:field="${member.id}"></td>
				</tr>
				<tr>
					<th>이름</th>
					<td th:field="${member.name}"></td>
				</tr>
				<tr>
					<th>이메일</th>
					<td th:field="${member.email}"></td>
				</tr>
				<tr>
					<th>연락처</th>
					<td th:field="${member.tel}"></td>
				</tr>
			</tbody>
		</table>

		<a href="/member/edit" class="btn btn-success">회원정보수정</button>
			<a href="/member/" class="btn btn-warning">탈퇴</button>

				</div>
				</div>
</body>

</html>